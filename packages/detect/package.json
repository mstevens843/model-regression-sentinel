{
  "name": "@model-regression-sentinel/detect",
  "version": "0.1.0",
  "description": "Tell provider drift apart from sampling noise: paired permutation testing against an empirically calibrated null, FDR-controlled per-case screening, and a computed minimum detectable effect.",
  "license": "MIT",
  "author": "Mathew Stevens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstevens843/model-regression-sentinel.git",
    "directory": "packages/detect"
  },
  "bugs": {
    "url": "https://github.com/mstevens843/model-regression-sentinel/issues"
  },
  "homepage": "https://github.com/mstevens843/model-regression-sentinel/tree/main/packages/detect#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE"],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@model-regression-sentinel/spec": "workspace:^",
    "@model-regression-sentinel/run": "workspace:^"
  }
}
