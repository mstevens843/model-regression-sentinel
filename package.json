{
  "name": "model-regression-sentinel-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Provider drift detection: watch a pinned model alias for behavior that moved when your code did not, and tell drift apart from sampling noise.",
  "license": "MIT",
  "author": "Mathew Stevens",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "audit:release": "bash scripts/audit-release.sh",
    "blocks:check": "node scripts/generated-blocks.mjs --check",
    "blocks:write": "node scripts/generated-blocks.mjs",
    "build": "turbo run build",
    "build:release": "node scripts/build-release.mjs",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:composition": "node scripts/case-composition.mjs",
    "examples": "turbo run build && tsx examples/detectorHonesty.ts && tsx examples/driftReport.ts",
    "format": "biome format --write .",
    "hooks:install": "lefthook install",
    "lint": "biome check .",
    "lint:fix": "biome check --fix --unsafe .",
    "record:freeze": "bash scripts/record-freeze.sh",
    "release": "node scripts/refuse-publish.mjs",
    "study:calibrate": "node scripts/calibrate.mjs",
    "study:collect": "node scripts/run-study.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:corpus": "bash scripts/verify-corpus.sh",
    "verify:freeze": "bash scripts/verify-freeze.sh",
    "verify:release": "sentinel release verify dist/release",
    "watch:status": "sentinel watch --status",
    "write:manifest": "node scripts/write-manifest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.9",
    "@model-regression-sentinel/cli": "workspace:*",
    "@types/node": "^20.16.13",
    "lefthook": "^1.8.2",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
